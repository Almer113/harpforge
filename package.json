{
  "name": "harpforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "node --disable-warning=ExperimentalWarning scripts/server.mjs deploy",
    "undeploy": "node --disable-warning=ExperimentalWarning scripts/server.mjs undeploy",
    "deploy:status": "node --disable-warning=ExperimentalWarning scripts/server.mjs status",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "oxlint --deny-warnings src server scripts",
    "check": "npm run typecheck && npm run lint && npm test && vite build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "abcjs": "^6.7.1",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "hyphen": "1.14.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
